# Copiar este archivo como .env y completar las contraseñas.

# --- Base de datos (SQL Server) ---
# Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD='cambiar-esta-contraseña'
DB_NAME=sistema_mercado
DB_USER=sa
DB_HOST=db
DB_PORT=1433

# --- Django ---
DJANGO_SECRET_KEY='cambiar-esta-clave'
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
# Vacio: la pantalla usa /api de su misma direccion (Vite se lo pasa al backend). Sirve para PC y celular.
VITE_API_URL=
